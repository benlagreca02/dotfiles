#!/usr/bin/sh

# This started pretty much fully AI generated, but I've tweaked it and
# re-written it so much, its basically hand written
#
# DOES NOT SUPPORT CONFIG FILES THAT HAVE SPACES IN THEIR NAMES/PATHS
#
# Entries take the form 
# <Human readable name>:<filepath>

configs=(
    "this script:~/.local/bin/scripts/edit-config-selector"
    "kitty config:~/.config/kitty/kitty.conf"
    "vimrc:~/.vimrc"
    "bashrc:~/.bashrc"
    "tmux.conf:~/.config/tmux/tmux.conf"
    "waybar config:~/.config/waybar/config.jsonc"
    "waybar style:~/.config/waybar/style.css"
    "dunst:~/.config/dunstrc"
    "newsboat:~/.config/newsboat/config"
    "important packages:~/.local/packages"
    ""
)

# Folders here will, recursively, have their files added to the menu
configFolders=(
    "~/.config/hypr"
    "~/.local/bin/scripts"
    "~/.config/wal"
)

for folder in "${configFolders[@]}"; do
    # find can't handle the ~ character, and I don't want $HOME everywhere
    eval folderExpanded="$folder"
    for path in $(find "$folderExpanded" -type f); do
        # basename takes 0.002 wall secods  and parameter expansion took 0
        # time is slow, this is like recording a drag race with a calendar...
        # filename=$(basename "$path")
        filename=${path##*/}
        # I'm being REALLY picky... I want to cut out the /home/ben and replace
        # with ~. But I don't want to use sed
        # ASSUMES ALL PATHS START WITH HOME
        prettyPath=${path/#"$HOME"/"~"}
        configs+=("$filename:$prettyPath")
    done
done

selection=$(for line in "${configs[@]}"; do
    printf "%s\n" "$line"
done | column -t -s ":" | rofi -dmenu -p "File to edit")

# Greedily match ALL preceeding whitespace (will leave nothing but filepath)
# we need to expand the path and eval it, otherwise it tries to open a file
# literally at "~", instead of /home/...
configPath=$(eval echo "${selection##*[ ]}")
[ -n "$configPath" ] && $TERMINAL -e $EDITOR $configPath

