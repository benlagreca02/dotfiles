#!/bin/bash
# This script just
# - checks if I'm on my home network
# - If I am, RSYNC to a device that *has* my nas mounted

# I've had issues with dolphin and permenant nas mounts when not on my network,
# hence the weird SCP thing. I also couldn't get the behavior I  wanted from
# mounting and samba and etc/fstab, so here we are. Stupid roundabout methods

# Returns 
# - 0 on success
# - 1 not on home network
# - 2 rsync fail

LOCAL_DIR="$HOME/Documents/myLogs"
REMOTE_HOST="gamer@192.168.1.137"
REMOTE_DIR="/nas/ben/myLogs"
SSID="BnL"

# Reminder to future Ben:
# nmcli: 
#   -t:terse (for scripting)
#   -f: fields (what will be returned)
#   dev wifi: give info about wifi connection 
# The "dev wifi" assumes the device is using wifi.
# THIS WILL MOST LIKELY BREAK IF USING ETHERNET.
# For now, I primarily use laptops, so I won't worry about this.
# grep's ^ means "must be begining of line"
# matches to 
# "yes:SSID"
# cut:
#   -d delimiter
#   -f field (after cutting)
echo "Checking network SSID's"
CURR_SSID=$(nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2)

if [ "$CURR_SSID" != "$SSID" ]; then
    echo "NOT on home network, can't rsync your logs!"
    exit 1
fi

echo "Pushing local to server"
rsync -avz "$LOCAL_DIR/" "$REMOTE_HOST:$REMOTE_DIR"
echo "Pulling server to local"
rsync -avz "$REMOTE_HOST:$REMOTE_DIR/" "$LOCAL_DIR"
echo "Synchronize complete!"
