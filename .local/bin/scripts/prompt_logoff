#!/usr/bin/sh

options="Shutdown\nRestart\nSuspend"

# -e is "interpret backslashes"
# -i is case insensitive
case $(echo -e $options | rofi -i -dmenu) in
    "Shutdown")
        systemctl poweroff;;
    "Restart")
        systemctl reboot;;
    "Suspend")
        systemctl suspend;;
    *)
        # Do nothing
        ;;
esac



