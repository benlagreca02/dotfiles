#!/bin/sh

# Parses through an exported bookmarks file and generates another
# Inputs arguments:
#       filepath of HTML export from browser
#       filepath of OUTPUT file, if not specified, defaults to `web`
# Dependencies:
#       sed
#       grep


function print_help_exit()
{
    printf "\nUsage:\n"
    printf "  ParseBookmarkExport filepath [outputfile]\n\n"
    printf "outputfile, if not specified, defaults to 'web'\n\n"
    exit 1
}

[[ $# -lt 1 || $# -gt 2 ]] && print_help_exit

INPUT=$1

[[ ! -e $INPUT ]] && echo "File '$INPUT' doesn't exist!" && exit 2

OUTPUT="${2:-"web"}"

echo "Reading from '$INPUT' and writing to '$OUTPUT'..."

# Honestly unnecessary
# [[ -e $FILEPATH ]] && echo "Warning, overwriting file!"

# ag HREF $INPUT
# grep '<A HREF=("https://.*")>(.*)</A>' $INPUT > $OUTPUT
# /<A HREF=("https:\/\/.*")>(.*)<\/A>/gm
# cat $INPUT | sed 's/<A HREF=("https:\/\/.*")>(.*)<\/A>/\1 \2/gm'

# REGEX: 
# /<A HREF="(http[s]?:\/\/.*) ADD_DATE.*">(.*)<\/A>/gm
# Matches link in group 1, and name in group 2 (if there's a name)
# REALLY not awesome... I'm doing it this way as more practice with RegEx
# awk 'match($0, /<A HREF="(http[s]?:\/\/.*) ADD.*">(.*)<\/A>/gm, groups) {print "LINK:" groups[1] "NAME:" groups[2]}' $INPUT 
    # if (match($0, /<A HREF="(http[s]?:\/\/.*) ADD.*">(.*)<\/A>/g, arr)) {
awk '{
    if (match($0, /<A HREF="(http[s]?:\/\/.*)" ADD_DATE.*">(.*)<\/A>/, arr)) {
        print arr[2]"\t"arr[1];
    }
}' $INPUT > $OUTPUT

echo $OUTPUT generated

# echo Note there may be entires without names if you just have a bookmark as the icon, without any text like I do sometimes...
# check and see if there are any 

# if there are any tab characters at the begining of a line, then there are
# incomplete entries (enteries without text)

# Look for tabs at the begining of the file
BAD_ENTRIES=$(grep -P "^\t" $OUTPUT)
[[  -z "$BAD_ENTRIES" ]] && echo "No nameless bookmarks detected!" && exit 0

printf "Nameless bookmarks detected! Bookmarks:\n$BAD_ENTRIES\n"
read -p "Interactively fix them? [y/n]: " CHOICE
# echo $CHOICE

[[ $CHOICE != y ]] && exit 0

printf "\nParsing bad entries...\n"

# some sed garbage here

# FOR LINE IN BAD_ENTRIES
for LINE in $BAD_ENTRIES; do
    printf "\nLine:\n$LINE\n\n"
    read -p "Enter name: " LABEL
    # echo sed 's/"$LINE"/"$LABEL$LINE"/g' $OUTPUT
    sed -i "s|\t$LINE|$LABEL\t$LINE|g" $OUTPUT
    # sed 's|"$LINE"|"$LABEL$LINE"|g' $OUTPUT
done

echo "All Clean, happy scripting!"
