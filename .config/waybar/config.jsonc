{
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": ["network", "backlight", "battery", "pulseaudio", "custom/power"],

    "tray": {
        "icon-size": 10,
        "spacing": 10
    },

    "hyprland/workspaces": {
        "format": "{icon}"
    },

    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },


    "network": {
        "format-wifi": " ",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "", 
        "max-length": 30,
        "tooltip-format-wifi": "{ipaddr}/{cidr} {essid}",
        // TODO should probably access the terminal
        // from some kind of macro incase I don't use kitty
        // Could change this but I don't care yet
        "on-click": "kitty -e 'nmtui'"
    },

    "clock": {
        "format": "{:%I:%M %p   %a %D}",
        "calendar": {
            "mode" : "month",
            "format":{
                 "today":"<span color='#00ccff'><b><i>{}</i></b></span>"
            } 
        },
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },


    "backlight": {
        "format": "{percent:3}% {icon} ",
        "format-icons": ["○","◔","◑","◕","●"]
    },


    "battery": {
        "bat": "BAT0",
        "states": {
              "full": 99,
              "good": 98,
              "normal": 98,
              "warning": 20,
              "critical": 10
        },

        "format": "{capacity:3}% {icon}",
        "format-good": "{capacity:3}% {icon}", 
        "format-full": "{capacity:3}% ",
        "format-icons": ["", "", "", "", ""],
        "interval": 20
    },

    "pulseaudio": {
        "format": "{volume:3}% {icon}",
        "format-bluetooth": "{icon}{volume:3}%  {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "   0% {icon}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            // TODO find monospace version of these, and maybe more of them
            "default": [" ", " ", ""]
        },
        "on-click": "pavucontrol"
    },


	"custom/power": {
		"format": " ",
        "tooltip-format": "linux is kil?",
		"on-click": "prompt_logoff"
	}
}
