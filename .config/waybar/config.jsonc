{
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": [
        "network",
        "bluetooth",
        // "custom/gammastep", // Not really happy with it yet
        "backlight",
        "battery",
        "pulseaudio",
        "custom/power"
    ],

    "tray": {
        "icon-size": 10,
        "spacing": 10
    },

    "hyprland/workspaces": {
        "format": " {icon}<sup>{windows}</sup> ",
        "window-rewrite-default": "?",
        "window-rewrite": {
            "class<firefox>": "", // Windows whose classes are "firefox"
            "title<.*youtube.*>": "",
            "title<.*Reddit.*>": "",  // Doesn't work...
            "class<discord>": "", 
            "class<spotify>": "", 
            "class<mpv>": "", 
            "class<kitty>": "",  
            "class<steam>": "", // unverified
            "title<.*Dolphin.*>": "",
            "title<vim>": " ",  // doesn't really work bc kitty changes into
            "title<vf>": " " // because I use my "vf" alias a lot
        }
    },

    // I don't use these... yet. I may make some in the future
    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "clock": {
        "format": "{:%I:%M %p   %a %D}",
        "calendar": {
            "mode" : "month",
            "format":{
                 "today":"<span color='#00ccff'><b><i>{}</i></b></span>"
            } 
        },
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },


    "network": {
        "format-wifi": "",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "", 
        "max-length": 30,
        "tooltip-format-wifi": "{ipaddr}/{cidr} {essid}",
        "on-click": "$TERMINAL -e 'nmtui'"
    },


    // TODO
    // https://man.archlinux.org/man/extra/waybar/waybar-bluetooth.5.en
    "bluetooth":{
        "on-click": "blueman-manager",
        // 
        "min-length": 3,
        "format-off": "<span color=\"gray\"></span>",
        "format-disabled": "<span color=\"red\"></span>",
        "format-on": "",
        "format-connected": "<span color=\"green\"></span>", 
        "tooltip-format": "Status:\t{status}\nCon'd:\t{num_connections}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%"
    },



    "backlight": {
        "format": "{percent:3}% {icon}",
        "format-icons": ["○","◔","◑","◕","●"]
    },


    "battery": {
        "bat": "BAT0",
        "states": {
              "full": 95,
              "good": 85,
              "normal": 65,
              "warning": 20,
              "critical": 10
        },

        "format": "{capacity:3}% {icon}",
        "format-good": "{capacity:3}% {icon}", 
        // "format-full": "{capacity:3}% ",
        "format-icons": ["", "", "", "", ""],
        "interval": 20
    },

    "pulseaudio": {
        "format": "{volume:3}% {icon}",
        "format-bluetooth": "{icon}{volume:3}%  {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "   0% {icon}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            // TODO find monospace version of these, and maybe more of them
            "default": [" ", " ", ""]
        },
        "on-click": "pavucontrol"
    },


	"custom/power": {
		"format": " ",
        "tooltip-format": "linux is kil?",
		"on-click": "prompt_logoff"
	},

    // TODO this needs quite a bit of work yet
    // Could combine with the brightness one?
	"custom/gammastep": {
        "tooltip-format": "{text}",
        // "exec": "gammastep -p",
        // TODO make this button actaully change icons
        "format": "{icon}",
        "format-source": "{icon} ",
        "format-icons": ["", ""],
        "exec": "get_curr_screen_temp" // custom script
        // "restart-interval": 600,  // every 5 minutes
    }

}
