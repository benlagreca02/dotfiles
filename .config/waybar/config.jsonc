{
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": ["network", "backlight", "battery", "pulseaudio", "custom/power"],

    "tray": {
        "icon-size": 10,
        "spacing": 10
    },

    "hyprland/workspaces": {
        "format": "{icon}"
    },

    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },


    "network": {
        "format-wifi": " ",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "", 
        "max-length": 50,
        "tooltip-format-wifi": "{ipaddr}/{cidr} {essid}",
        // TODO should probably access the terminal
        // from some kind of macro incase I don't use kitty
        // Could change this but I don't care yet
        "on-click": "kitty -e 'nmtui'"
    },

    "clock": {
        "format": "{:%I:%M %p  %a %D}",
        "calendar": {
            "mode" : "month",
            "format":{
                 "today":"<span color='#00ccff'><b>{}</b></span>"
            } 
        },
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },


    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["○","◔","◑","◕","●"]
    },


    "battery": {
        "bat": "BAT0",
        "states": {
              "full": 99,
              "good": 98,
              "normal": 98,
              "warning": 20,
              "critical": 20
        },

        "format": "{icon} {capacity}%",
        "format-good": "{icon} {capacity}%", 
        "format-full": "   {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 30
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon}{volume}%  {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "{icon} 0%",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },


    // Doesn't do anything atm
	"custom/power": {
		"format": " "
		// "on-click": "wlogout"
	}
}
