
output "AOC 24G4 12VQ7HA012846" {
    mode 1920x1080@144.00
    position 0,0
    scale 1
    alias $HOME_1
}

output "Dell Inc. S2318HN/NX NHD1J81M19BI" {
    mode 1920x1080@60.00
    position -1920,0
    scale 1
    alias $HOME_2
}

profile docked {
    output $HOME_1 enable 
    output $HOME_2 enable
    output eDP-1 disable

    exec hyprctl keyword source "$HOME/.config/hypr/workspaces/pc-or-docked.conf"
}

profile undocked {
    output eDP-1 enable mode 1920x1080 position 0,0 scale 1
    exec hyprctl keyword source "$HOME/.config/hypr/workspaces/undocked.conf"
}

profile pc {
    output $HOME_1 enable
    output $HOME_2 enable
    exec hyprctl keyword source "$HOME/.config/hypr/workspaces/pc-or-docked.conf"
}
